{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-coffee-can",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI has no local simulator, so `npm run dev` uses the real service (needs `wrangler login`).
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/oauth/*"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "PortfolioAgent", "name": "PortfolioAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["PortfolioAgent"], "tag": "v1" }],
  "observability": { "enabled": true }
}
